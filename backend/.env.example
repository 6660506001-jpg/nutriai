# Local development (ค่าเริ่มต้น)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=nutrition_db

# Production — Railway จะใส่ให้อัตโนมัติเมื่อเชื่อม MySQL plugin
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# URL ของ frontend บน Vercel (คั่นด้วย comma ถ้ามีหลาย URL)
# FRONTEND_URL=https://nutriai.vercel.app

# พอร์ต (Railway ใส่ PORT ให้อัตโนมัติ)
# PORT=8000

# ไม่บังคับ — API ประมาณแคลอรี่จาก CalorieNinjas
# CALORIE_NINJAS_API_KEY=
