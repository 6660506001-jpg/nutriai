# คัดลอกเป็น .env แล้วใส่ URL backend หลัง deploy Railway
# ตัวอย่าง: https://nutriai-production.up.railway.app
REACT_APP_API_BASE_URL=

# URL สาธารณะของ frontend สำหรับ QR / แชร์ลิงก์ (เช่น https://nutriai.vercel.app)
REACT_APP_PUBLIC_URL=

# (ทางเลือก) บังคับ URL สำหรับ QR ตอน dev — เช่น http://192.168.1.5:3000
REACT_APP_LAN_URL=

# สำหรับ dev บนมือถือใน WiFi เดียวกัน (ไม่จำเป็นตอน deploy)
HOST=0.0.0.0
WDS_SOCKET_HOST=0.0.0.0
